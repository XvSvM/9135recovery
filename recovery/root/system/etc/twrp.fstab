/boot              emmc     /dev/block/boot              flags=display=boot;backup=1;flashimg=1
/misc              emmc     /dev/block/misc              flags=display=misc;backup=1;flashimg=1
/system            ext4     /dev/block/system            flags=display=system;backup=1;flashimg=1
/vendor            ext4     /dev/block/vendor            flags=display=vendor;backup=1;flashimg=1
