/odm_ext           ext4     /dev/block/odm_ext           flags=display=odm_ext;backup=1;flashimg=1
/oem               ext4     /dev/block/oem               flags=display=oem;backup=1;flashimg=1
/param             ext4     /dev/block/param             flags=display=param;backup=1;flashimg=1
/product           ext4     /dev/block/product           flags=display=product;backup=1;flashimg=1
/metadata          ext4     /dev/block/metadata          flags=display=metadata;backup=1;flashimg=1
/tee               ext4     /dev/block/tee               flags=display=tee;backup=1;flashimg=1
/cache             ext4     /dev/block/cache             flags=display=cache;backup=1;flashimg=1
/data              ext4     /dev/block/userdata          flags=display=data;backup=1;flashimg=1
/sdcard            vfat     /dev/block/mmcblk1p1         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk1p2         flags=display=sdcard;backup=1;flashimg=1
/sdcard            vfat     /dev/block/mmcblk1p3         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk1p4         flags=display=sdcard;backup=1;flashimg=1
/sdcard            vfat     /dev/block/mmcblk1p5         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk1p6         flags=display=sdcard;backup=1;flashimg=1
/sdcard            vfat     /dev/block/mmcblk2p1         flags=display=sdcard
/sdcard            vfat     /dev/block/mmcblk2p2         flags=display=sdcard;backup=1;flashimg=1
